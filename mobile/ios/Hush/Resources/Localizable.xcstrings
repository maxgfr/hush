    "idIntro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No sign-up: this identifier is computed on your device from your public keys (Ed25519 + ML-DSA-65). Nobody can impersonate it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d'inscription : cet identifiant est calculé sur votre appareil à partir de vos clés publiques (Ed25519 + ML-DSA-65). Personne ne peut l'usurper."
          }
        }
      }
    },
    "idPlaceholder": {
