          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouve votre correspondant par Bluetooth ou Wi-Fi, même sans réseau. Les appareils proches peuvent remarquer un appareil hush tant qu'un lien attend. Gardez hush ouvert : iOS le met en pause en arrière-plan."
          }
        }
      }
