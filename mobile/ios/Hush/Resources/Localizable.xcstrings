    "idTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your identifier"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre identifiant"
          }
        }
      }
    },
    "intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a link, send it, talk. End-to-end encrypted with post-quantum cryptography, no account, no server. When you end it, everything is gone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez un lien, envoyez-le, discutez. Chiffré de bout en bout avec une cryptographie post-quantique, sans compte ni serveur. Quand vous terminez, tout disparaît."
          }
        }
      }
    },
    "invalidCode": {
