    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "hush finds the people you talk to nearby over Bluetooth, with no network."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "hush trouve vos correspondants à proximité par Bluetooth, sans réseau."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "hush scans the QR code of a link."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "hush scanne le QR code d'un lien."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "hush finds the people you talk to on the same Wi-Fi, or directly between iPhones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "hush trouve vos correspondants sur le même Wi-Fi, ou directement entre iPhone."
          }
        }
      }
    }
